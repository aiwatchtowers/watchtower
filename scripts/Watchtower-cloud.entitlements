<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Watchtower.entitlements PLUS the iCloud/CloudKit and push entitlements
         the mobile hub needs. Used ONLY by build-app.sh's real-identity branch
         with an embedded provisioning profile: these are restricted
         entitlements, and amfid kills an ad-hoc signed app that carries them,
         so `make app-dev` keeps the base file. Keep the base keys below in
         sync with Watchtower.entitlements (scripts/tests/test-build-app-cloud.sh
         checks it). One container for every build flavor. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.aiwatchtowers.watchtower</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- CKSyncEngine pushes. macOS spells the key with the
         com.apple.developer. prefix; Developer ID signing needs production. -->
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
</dict>
</plist>
