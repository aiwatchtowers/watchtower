#!/bin/bash
# Blocks a push whose commits add live-install data (see scripts/leak-check.sh).
# Installed for every worktree of a clone by `make hooks`
# (git config core.hooksPath scripts/git-hooks).
#
# git feeds one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
ROOT="$(git rev-parse --show-toplevel)"
rc=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote ref pushes no content.
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        # A new branch (or a remote tip this clone has never fetched): scan what
        # the branch adds on top of main.
        base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
        if [ -z "$base" ]; then
            echo "pre-push: no merge-base with origin/main for $local_ref — run 'git fetch origin' and push again" >&2
            exit 1
        fi
    fi

    echo "pre-push: leak-check $local_ref -> $remote_ref"
    bash "$ROOT/scripts/leak-check.sh" "$base..$local_sha" || rc=1
done

exit $rc
