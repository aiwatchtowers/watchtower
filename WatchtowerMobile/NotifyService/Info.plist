<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shared Keychain group the alert material is read from (mobile E2E spec §2.6); the
	     extension's only keychain-access-groups entry. Expanded at build time. -->
	<key>WTKeychainAlertGroup</key>
	<string>$(AppIdentifierPrefix)com.aiwatchtowers.watchtower.mobile.alerts</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.usernotifications.service</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).NotificationService</string>
	</dict>
</dict>
</plist>
