<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shares the app's group container, where the replica and outbox live. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.aiwatchtowers.watchtower.mobile</string>
	</array>
	<!-- Fetches the ask alert a WatchtowerSignal push names (mobile E2E Task 18); must match
	     WatchtowerCloud.containerID. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.aiwatchtowers.watchtower</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- The alerts Keychain group ONLY (spec §2.6, F21): K_alert and the hub's public signing key.
	     The app's private group, with every other key, is out of reach. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.aiwatchtowers.watchtower.mobile.alerts</string>
	</array>
</dict>
</plist>
