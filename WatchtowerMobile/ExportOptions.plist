<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ExportOptions for `make mobile-archive` (Plan 6 Decision 9): produce a
         TestFlight-ready .ipa from the Release archive. `make mobile-testflight`
         uploads through a build/ copy with destination=upload and the ASC
         API key kept outside the repo. NO teamID here on purpose: signing identity comes from the
         archive (DEVELOPMENT_TEAM in the gitignored Signing.xcconfig); this
         file stays committable without leaking any ASC identifier. -->
    <key>method</key>
    <string>app-store-connect</string>
    <!-- Write the .ipa to -exportPath; mobile-testflight flips this to upload. -->
    <key>destination</key>
    <string>export</string>
    <!-- Matches CODE_SIGN_STYLE = Automatic in Signing.xcconfig.template. -->
    <key>signingStyle</key>
    <string>automatic</string>
    <!-- dSYMs ride along in the .ipa so TestFlight crash logs symbolicate. -->
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
