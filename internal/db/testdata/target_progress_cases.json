[
  {
    "name": "dismissing a child drops it from the parent average",
    "targets": [
      {"id": 1, "status": "todo", "progress": 0.5},
      {"id": 2, "parent_id": 1, "status": "done", "progress": 1.0},
      {"id": 3, "parent_id": 1, "status": "todo", "progress": 0.0}
    ],
    "op": {"kind": "status", "id": 3, "status": "dismissed"},
    "want": {"progress": {"1": 1.0, "2": 1.0, "3": 0.0}, "touched": [1, 3]}
  },
  {
    "name": "a leaf status change sets its own progress and walks every ancestor",
    "targets": [
      {"id": 1, "status": "todo", "progress": 0.5},
      {"id": 2, "parent_id": 1, "status": "todo", "progress": 0.5},
      {"id": 3, "parent_id": 2, "status": "todo", "progress": 0.0},
      {"id": 4, "parent_id": 2, "status": "done", "progress": 1.0}
    ],
    "op": {"kind": "status", "id": 3, "status": "in_progress"},
    "want": {"progress": {"1": 0.75, "2": 0.75, "3": 0.5, "4": 1.0}, "touched": [1, 2, 3]}
  },
  {
    "name": "an unchanged average does not touch the parent",
    "targets": [
      {"id": 1, "status": "todo", "progress": 0.5},
      {"id": 2, "parent_id": 1, "status": "in_progress", "progress": 0.5},
      {"id": 3, "parent_id": 1, "status": "in_progress", "progress": 0.5}
    ],
    "op": {"kind": "recompute", "id": 1},
    "want": {"progress": {"1": 0.5, "2": 0.5, "3": 0.5}, "touched": []}
  },
  {
    "name": "only dismissed children left derives progress from own status",
    "targets": [
      {"id": 1, "status": "blocked", "progress": 0.9},
      {"id": 2, "parent_id": 1, "status": "dismissed", "progress": 1.0}
    ],
    "op": {"kind": "recompute", "id": 1},
    "want": {"progress": {"1": 0.2, "2": 1.0}, "touched": [1]}
  },
  {
    "name": "deleting the last child derives the parent from its own status",
    "targets": [
      {"id": 1, "status": "in_progress", "progress": 0.9},
      {"id": 2, "parent_id": 1, "status": "done", "progress": 1.0}
    ],
    "op": {"kind": "delete", "id": 2},
    "want": {"progress": {"1": 0.5}, "touched": [1]}
  },
  {
    "name": "reparenting recomputes both the old and the new parent",
    "targets": [
      {"id": 1, "status": "todo", "progress": 1.0},
      {"id": 2, "status": "todo", "progress": 0.0},
      {"id": 3, "parent_id": 1, "status": "done", "progress": 1.0},
      {"id": 4, "parent_id": 2, "status": "todo", "progress": 0.0}
    ],
    "op": {"kind": "reparent", "id": 3, "parent_id": 2},
    "want": {"progress": {"1": 0.0, "2": 0.5, "3": 1.0, "4": 0.0}, "touched": [1, 2, 3]}
  },
  {
    "name": "creating a child recomputes its parent",
    "targets": [
      {"id": 1, "status": "todo", "progress": 1.0},
      {"id": 2, "parent_id": 1, "status": "done", "progress": 1.0}
    ],
    "op": {"kind": "create", "parent_id": 1, "status": "todo"},
    "want": {"progress": {"1": 0.5, "2": 1.0, "3": 0.0}, "touched": [1, 3]}
  },
  {
    "name": "a parent cycle stops the walk after one lap",
    "targets": [
      {"id": 1, "parent_id": 2, "status": "todo", "progress": 0.0},
      {"id": 2, "parent_id": 1, "status": "todo", "progress": 0.0},
      {"id": 3, "parent_id": 1, "status": "done", "progress": 1.0}
    ],
    "op": {"kind": "recompute", "id": 1},
    "want": {"progress": {"1": 0.5, "2": 0.5, "3": 1.0}, "touched": [1, 2]}
  },
