{
  "_doc": "The manual AI-mute writers' rule, shared by Go (SetMuteForLLM, TestMuteCases) and Swift (ChannelStatsQueries.toggleMuteForLLM, testMuteCasesMatchGo). before is the channel_settings row (null = no row), action is mute or unmute, after is the row the writer leaves. muted_at \"$now\" means set to the write's time (non-empty, differs from before).",
  "cases": [
    {"name": "no row, mute", "before": null, "action": "mute",
     "after": {"is_muted_for_llm": 1, "muted_at": "$now", "muted_by_exclusion": 0}},
    {"name": "no row, unmute", "before": null, "action": "unmute",
     "after": {"is_muted_for_llm": 0, "muted_at": "", "muted_by_exclusion": 0}},
    {"name": "unmuted, mute", "before": {"is_muted_for_llm": 0, "muted_at": "", "muted_by_exclusion": 0}, "action": "mute",
     "after": {"is_muted_for_llm": 1, "muted_at": "$now", "muted_by_exclusion": 0}},
    {"name": "muted, mute again keeps muted_at", "before": {"is_muted_for_llm": 1, "muted_at": "2026-01-02T03:04:05Z", "muted_by_exclusion": 0}, "action": "mute",
     "after": {"is_muted_for_llm": 1, "muted_at": "2026-01-02T03:04:05Z", "muted_by_exclusion": 0}},
    {"name": "muted, unmute clears muted_at", "before": {"is_muted_for_llm": 1, "muted_at": "2026-01-02T03:04:05Z", "muted_by_exclusion": 0}, "action": "unmute",
     "after": {"is_muted_for_llm": 0, "muted_at": "", "muted_by_exclusion": 0}},
    {"name": "muted by Stop syncing, mute takes it over", "before": {"is_muted_for_llm": 1, "muted_at": "2026-01-02T03:04:05Z", "muted_by_exclusion": 1}, "action": "mute",
     "after": {"is_muted_for_llm": 1, "muted_at": "2026-01-02T03:04:05Z", "muted_by_exclusion": 0}},
    {"name": "muted by Stop syncing, unmute", "before": {"is_muted_for_llm": 1, "muted_at": "2026-01-02T03:04:05Z", "muted_by_exclusion": 1}, "action": "unmute",
     "after": {"is_muted_for_llm": 0, "muted_at": "", "muted_by_exclusion": 0}}
  ]
}
