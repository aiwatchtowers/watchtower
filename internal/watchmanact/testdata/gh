#!/bin/sh
# A fake gh for the protection check tests. FAKE_GH_MODE picks the answer:
# protected (a required approving review), noreview (protected, no review
# required), unprotected (GitHub's 404), missing (exit 127, as a shell
# reports a missing command).
case $FAKE_GH_MODE in
missing) exit 127 ;;
esac
case $* in
"api repos/{owner}/{repo} --jq .default_branch")
	echo main
	;;
"api repos/{owner}/{repo}/branches/main/protection")
	case $FAKE_GH_MODE in
	protected) echo '{"url":"https://api.github.com/repos/acme/app/branches/main/protection","required_pull_request_reviews":{"required_approving_review_count":1}}' ;;
	noreview) echo '{"url":"https://api.github.com/repos/acme/app/branches/main/protection","required_status_checks":{"strict":true}}' ;;
	unprotected)
		echo '{"message":"Branch not protected","documentation_url":"https://docs.github.com/rest","status":"404"}'
		echo 'gh: Branch not protected (HTTP 404)' >&2
		exit 1
		;;
	*) exit 2 ;;
	esac
	;;
*)
	echo "fake gh: unexpected arguments: $*" >&2
	exit 2
	;;
esac
